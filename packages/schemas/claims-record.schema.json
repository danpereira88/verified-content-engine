{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claims-record.schema.json",
  "title": "claims-record",
  "type": "object",
  "properties": {
    "source_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "$ref": "common.schema.json#/$defs/category"
          },
          "confidence": {
            "$ref": "common.schema.json#/$defs/confidence"
          }
        },
        "required": [
          "text",
          "quote",
          "location",
          "category",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "claims",
    "summary"
  ],
  "additionalProperties": false
}
