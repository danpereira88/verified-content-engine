{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-type.schema.json",
  "title": "content-type",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "length_words": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 2
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "purpose",
          "required"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "name",
    "length_words",
    "sections",
    "checklist"
  ],
  "additionalProperties": false
}
