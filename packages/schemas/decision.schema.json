{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision.schema.json",
  "title": "decision",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "product_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/datetime"
    },
    "derived_guardrails": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "banned-term",
              "naming",
              "deprioritize",
              "emphasis",
              "other"
            ]
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decision_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "rule",
          "type",
          "decision_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "product_id",
    "text",
    "author",
    "created_at",
    "derived_guardrails"
  ],
  "additionalProperties": false
}
